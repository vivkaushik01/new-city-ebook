# Copy this file to .env and fill in real values. Never commit .env itself.

# ---------- Razorpay (Settings > API Keys in the Razorpay Dashboard) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Google Sheet (your buyer database — see apps-script/Code.gs) ----------
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# ---------- The book file itself (Google Drive) ----------
BOOK_FILE_ID=your_google_drive_file_id

# ---------- Server ----------
PORT=3000

# Your live Render/Koyeb URL. Required for the self-ping keep-alive to work
# (server.js pings ${SITE_URL}/health on an interval) and must match
# config.js's SITE_URL and the Apps Script CONFIG.SITE_URL. Leave the
# localhost value while testing locally — self-ping just stays disabled.
SITE_URL=https://your-app-name.onrender.com

# How many hours a download link stays valid after purchase (also enforced
# one-time regardless of this window). Keep in sync with DOWNLOAD_LINK_HOURS
# in config.js, which only exists there to word the FAQ answer correctly.
DOWNLOAD_EXPIRY_HOURS=48

# How often (minutes) the server pings its own /health route to stop
# Render's free tier from sleeping after 15 minutes of no traffic. Keep this
# under 15. Pair with an external UptimeRobot/cron-job.org monitor too (see
# DEPLOY.md) — self-ping only keeps an already-running process warm, it
# can't restart a crashed one the way an external monitor's alerting can.
SELF_PING_MINUTES=10
